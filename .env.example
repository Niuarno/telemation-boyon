# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
AUTHORIZED_CHAT_IDS=-100xxxxxxxxxx

# ==============================================================================
# Shopify Store Configuration
# ==============================================================================
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# --- AUTHENTICATION (Use EITHER Option A OR Option B) ---
# Option A: Legacy Custom App Admin Access Token
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Option B: Shopify Dev Dashboard Client Credentials
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# Webhook secret from Shopify Admin -> Settings -> Notifications -> Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_API_VERSION=2024-01

# ==============================================================================
# WhatsApp Configuration
# ==============================================================================
ENABLE_WHATSAPP=true
WHATSAPP_GROUP_ID=120363xxxxxxxxx@g.us

# ==============================================================================
# Server Configuration
# ==============================================================================
PORT=3000

# ==============================================================================
# Boyon OMS Dashboard & Supabase Integration
# ==============================================================================
# Direct Supabase Ingestion (Recommended for Render)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# (Optional) Direct Dashboard Ingest URL
DASHBOARD_INGEST_URL=
DASHBOARD_INTERNAL_SECRET=telemation_secret_passphrase_here

