# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# The Bot Token given by @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Chat ID where new order notifications should be sent.
# This is usually a Group ID (negative integer, e.g. -1001234567890) or Channel ID.
# Tip: Add your bot to the group and run /status to see the current Chat ID!
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# (Optional) Comma-separated list of Telegram Chat IDs or User IDs authorized
# to execute bot commands like /orders and /order. If left blank, defaults to TELEGRAM_CHAT_ID.
AUTHORIZED_CHAT_IDS=

# ==============================================================================
# Shopify Store Configuration
# ==============================================================================
# Your Shopify store myshopify domain (e.g. your-store-name.myshopify.com)
# Note: Do not include "https://"
SHOPIFY_SHOP_DOMAIN=your-store-name.myshopify.com

# --- AUTHENTICATION METHOD (Choose EITHER Option A OR Option B) ---

# OPTION A: If you have an existing Admin-Created Custom App:
# Static Admin API Access Token (starts with "shpat_")
# Generated under Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_api_token_here

# OPTION B: If you created an app via the new Shopify Dev Dashboard (dev.shopify.com):
# Client ID and Client Secret (used for automatic Client Credentials Token exchange)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- WEBHOOK CONFIGURATION ---
# Shopify Webhook Signing Secret (or API Secret Key from your App)
# Used to verify HMAC signature (X-Shopify-Hmac-Sha256) on incoming webhooks.
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Shopify Admin API Version (default: 2024-01)
SHOPIFY_API_VERSION=2024-01

# ==============================================================================
# Server Configuration
# ==============================================================================
# Port for the local Express webhook listener
PORT=3000
